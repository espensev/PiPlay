<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Quality-first publish posture (ADR-0002): no trimming/single-file/AOT. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <AssemblyName>PiPlay</AssemblyName>
    <RootNamespace>PiPlay</RootNamespace>

    <!-- App / taskbar icon and per-monitor DPI manifest (REQ-WINDOW-01). -->
    <ApplicationIcon>Assets\piplay.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Defaults so a plain `dotnet build` works even without the Build-PiPlay.ps1
         pipeline; the pipeline overrides these via -p:Version/-p:AssemblyVersion/
         -p:FileVersion/-p:InformationalVersion (see scripts\Build-PiPlay.ps1). -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <!-- Keep ProductVersion (the Win32 field shown in file properties) a clean
         semantic version. The SDK otherwise appends "+<full-git-sha>" to the
         InformationalVersion; the commit is already recorded in build-info.json
         (sourceCommit), so the SHA here is redundant noise. Mirrors the SevIQ
         house style (NVG-SmoothControl .rc: ProductVersion == version string). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Release channel baked into the assembly and read at runtime by AppChannel. The default is the
         normal app; the Build-PiPlay.ps1 pipeline overrides this with -p:PiPlayChannel=Stable so a
         deployed stable copy gets its own data root (beside the exe), single-instance identity, and title. -->
    <PiPlayChannel Condition="'$(PiPlayChannel)' == ''">Default</PiPlayChannel>

    <!-- FileVersionInfo metadata surfaced by the pipeline's build-info.json. -->
    <Company>SevIQ</Company>
    <Product>PiPlay</Product>
    <Authors>SevIQ</Authors>
    <!-- AssemblyTitle drives the Win32 FileDescription (the column Task Manager / file
         properties show), mirroring the SevIQ house style (cf. NVG-SmoothControl's
         "SevIQ NVG Analysis Tool"). .NET does NOT derive FileDescription from Description. -->
    <AssemblyTitle>SevIQ PiPlay</AssemblyTitle>
    <!-- <Description> surfaces as the exe FileDescription (Task Manager / file properties).
         Copyright follows the SevIQ house style used across SevIQ products
         (cf. NVG-SmoothControl Resources\nvg_ingest.rc.in: "Copyright (C) 2026 SevIQ"). -->
    <Description>SevIQ PiPlay — watch YouTube in a movable, resizable Video Popout window.</Description>
    <Copyright>Copyright (C) 2026 SevIQ</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal test-only seams (e.g. MainWindow.ApplyResetState / PendingUrlForTests)
         to the regression suite without widening the public API. -->
    <InternalsVisibleTo Include="PiPlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Emitted as [assembly: AssemblyMetadata("PiPlay.Channel", "<channel>")] so a copied exe keeps
         its baked-in identity. AppChannel reads it at runtime (PIPLAY_CHANNEL env overrides for tests). -->
    <AssemblyMetadata Include="PiPlay.Channel" Value="$(PiPlayChannel)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the app icon as a WPF resource too, so XAML Image/Window.Icon can use it
         (it is also the exe ApplicationIcon above). -->
    <Resource Include="Assets\piplay.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compact-player shell assets: copied beside the app so WebView2 can map the
         PlayerShell folder to the https://piplay.local/ virtual host at runtime. These files are
         already default-included as None, so we Update (not Include) to set the copy behavior and
         avoid a duplicate-item build error. -->
    <None Update="PlayerShell\player.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="PlayerShell\player-shell.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
