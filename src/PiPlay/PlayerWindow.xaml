<Window x:Class="PiPlay.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PiPlay Video Popout"
        Width="960" Height="540"
        MinWidth="320" MinHeight="180"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Black"
        ShowInTaskbar="True"
        UseLayoutRounding="False"
        SnapsToDevicePixels="True">

  <!-- Borderless media window with native edge/corner resize (spec 16.1, 26.5).
       AllowsTransparency stays False (HwndHost WebView2 airspace). CaptionHeight=0:
       dragging is handled explicitly on the chrome strip so there's no accidental maximize. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="10"
                  CornerRadius="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <!-- Auto, not a fixed 32: strip auto-hide collapses the strip element, and the row must
           give the height back so the video actually fills the window (spec 7.2). -->
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Chrome strip: drag region + Pin + Close (always visible in MVP; fade is Phase 2). -->
    <Border x:Name="ChromeStrip" Grid.Row="0" Height="32" Background="{StaticResource SurfaceBase}"
            MouseLeftButtonDown="ChromeStrip_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="PiPlay" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center"
                   FontSize="12" Foreground="{StaticResource TextSecondary}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ToggleButton x:Name="FadeToggle" Style="{StaticResource PinToggle}" Width="30" Height="30"
                        Content="&#xE7B3;" Click="FadeToggle_Click" ToolTip="Fade controls when idle"
                        AutomationProperties.Name="Fade controls when idle" />
          <ToggleButton x:Name="PinToggle" Style="{StaticResource PinToggle}" Width="30" Height="30"
                        Content="&#xE840;" Click="PinToggle_Click" ToolTip="Pin on top"
                        AutomationProperties.Name="Pin popout on top" />
          <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Width="30" Height="30"
                  Content="&#xE922;" Click="FullscreenButton_Click" ToolTip="Expand popout"
                  AutomationProperties.Name="Expand popout" />
          <Button x:Name="CloseButton" Style="{StaticResource CloseIconButton}" Width="30" Height="30"
                  Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close popout (return video)"
                  AutomationProperties.Name="Close popout" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Compact error bar (spec 10.3 / Q-6, Stage 4): shown when the compact shell reports an
         IFrame API error, fails to load, or times out. A separate row, not an overlay — WPF can't
         render over the WebView2 HwndHost (airspace), and the bar leaves YouTube's own in-player
         error message visible (Q-5). Collapsed in normal mode and whenever there is no error. -->
    <Border x:Name="ErrorBar" Grid.Row="1" Background="{StaticResource SurfaceRaised}"
            Padding="10,6" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="ErrorText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                   FontSize="12" Foreground="{StaticResource TextPrimary}" />

        <Button x:Name="FallbackButton" Grid.Column="1" Style="{StaticResource AccentButton}"
                Margin="10,0,0,0" Content="Open normal page" Click="FallbackButton_Click"
                ToolTip="Reopen this video as the normal YouTube page"
                AutomationProperties.Name="Open normal page" />
        <Button x:Name="ErrorDismissButton" Grid.Column="2" Style="{StaticResource CloseIconButton}"
                Width="30" Height="30" Margin="6,0,0,0" Content="&#xE711;"
                Click="ErrorDismissButton_Click" ToolTip="Dismiss this message"
                AutomationProperties.Name="Dismiss player error" />
      </Grid>
    </Border>

    <!-- Resize inset band (REQ-WINDOW-02, overhaul Task 1): the WebView2 child HWND swallows
         WM_NCHITTEST, so the top-level window must own the edge pixels for the resize subclass to
         see them. Left/right/bottom margin == BorderlessResizeHitTestPolicy.ResizeBorderDip (the
         top band is the WPF ChromeStrip). Maximized goes full-bleed: resize zones are inert there
         and the band would only letterbox the video. XamlInvariantTests pins both values. -->
    <wv2:WebView2 x:Name="Player" Grid.Row="2">
      <wv2:WebView2.Style>
        <Style TargetType="{x:Type wv2:WebView2}">
          <Setter Property="Margin" Value="10,0,10,10" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                         Value="Maximized">
              <Setter Property="Margin" Value="0" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </wv2:WebView2.Style>
    </wv2:WebView2>
  </Grid>
</Window>
