<Window x:Class="PiPlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PiPlay settings"
        Width="520" Height="680" MinHeight="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        UseLayoutRounding="False"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <Style x:Key="SwatchToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource RadiusSwatch}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PresetToggle" TargetType="ToggleButton">
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource RadiusPanel}" Padding="10,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
    <!-- Bounded + scrollable (overhaul Task 5): the title bar stays fixed; the sections scroll.
         Frame model reconciled with the parallel main landing (b35c0dd): a fixed launch Height
         (clamped to the work area in the ctor) instead of SizeToContent, so the dialog cannot
         grow with future sections. -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Title bar (drag to move; close button) -->
      <Grid Grid.Row="0" Background="{DynamicResource SurfaceBase}" Height="42"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="Settings" Margin="16,0" VerticalAlignment="Center"
                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        <Button x:Name="CloseButton" Style="{StaticResource CloseIconButton}"
                Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close settings"
                HorizontalAlignment="Right" Margin="0,0,5,0" Click="CloseButton_Click" />
      </Grid>

      <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                    Focusable="False">
      <StackPanel Margin="20">

        <!-- Privacy: distinct Reset app state vs Clear browser data wording/actions
             (REQ-PRIVACY-01/-02; text sourced from PrivacyService so tests pin it). -->
        <TextBlock x:Name="PrivacySectionHeader" Text="Privacy" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />

        <TextBlock x:Name="ResetDescriptionText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,8" />
        <Button x:Name="ResetAppStateButton" Style="{StaticResource DarkButton}"
                HorizontalAlignment="Left" Click="ResetAppStateButton_Click" />

        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,18" />

        <TextBlock x:Name="ClearDescriptionText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
        <Button x:Name="ClearBrowserDataButton" Style="{StaticResource DarkButton}"
                HorizontalAlignment="Left" Click="ClearBrowserDataButton_Click" />

        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,18" />

        <!-- Appearance (overhaul Task 10): one theme preset + one shared accent replace the separate
             Pin/Fade color swatches. The accent drives Source Pin, Popout Pin, and Popout Fade. -->
        <TextBlock x:Name="AppearanceSectionHeader" Text="Appearance" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

        <TextBlock Text="Theme" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <!-- Copy matches the actual close-to-apply behavior (theme code review P3): theme and
             accent land on every open window when the dialog closes; only the opacity sliders
             (and this dialog's own corners) preview live while it is open. -->
        <TextBlock x:Name="ThemeHintText"
                   Text="Theme, accent, and corners apply to every open window when you close Settings - no restart needed. A preset sets the accent; the chips fine-tune it."
                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <ToggleButton x:Name="ThemeSharpDarkPreset" Style="{StaticResource PresetToggle}"
                        Content="Sharp Dark" Tag="sharp-dark" Click="ThemePreset_Click"
                        ToolTip="Sharp Dark theme" AutomationProperties.Name="Sharp Dark theme" />
          <ToggleButton x:Name="ThemeMinimalPreset" Style="{StaticResource PresetToggle}"
                        Content="Minimal" Tag="minimal" Click="ThemePreset_Click"
                        ToolTip="Minimal theme" AutomationProperties.Name="Minimal theme" />
          <ToggleButton x:Name="ThemeSoftGlassPreset" Style="{StaticResource PresetToggle}"
                        Content="Soft Glass" Tag="soft-glass" Click="ThemePreset_Click"
                        ToolTip="Soft Glass theme" AutomationProperties.Name="Soft Glass theme" />
        </StackPanel>

        <TextBlock Text="Accent color" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <ToggleButton x:Name="AccentChipCyan" Style="{StaticResource SwatchToggle}"
                        Background="#00D4FF" Tag="#00D4FF" Click="AccentChip_Click"
                        ToolTip="Accent: Cyan" AutomationProperties.Name="Accent Cyan" />
          <ToggleButton x:Name="AccentChipSteelBlue" Style="{StaticResource SwatchToggle}"
                        Background="#5AA9E6" Tag="#5AA9E6" Click="AccentChip_Click"
                        ToolTip="Accent: Steel blue" AutomationProperties.Name="Accent Steel blue" />
          <ToggleButton x:Name="AccentChipSteel" Style="{StaticResource SwatchToggle}"
                        Background="#4A8FAB" Tag="#4A8FAB" Click="AccentChip_Click"
                        ToolTip="Accent: Steel (muted)" AutomationProperties.Name="Accent Steel" />
          <ToggleButton x:Name="AccentChipViolet" Style="{StaticResource SwatchToggle}"
                        Background="#A78BFA" Tag="#A78BFA" Click="AccentChip_Click"
                        ToolTip="Accent: Violet" AutomationProperties.Name="Accent Violet" />
          <ToggleButton x:Name="AccentChipGreen" Style="{StaticResource SwatchToggle}"
                        Background="#38D996" Tag="#38D996" Click="AccentChip_Click"
                        ToolTip="Accent: Green" AutomationProperties.Name="Accent Green" />
          <ToggleButton x:Name="AccentChipAmber" Style="{StaticResource SwatchToggle}"
                        Background="#FFC857" Tag="#FFC857" Click="AccentChip_Click"
                        ToolTip="Accent: Amber" AutomationProperties.Name="Accent Amber" />
        </StackPanel>

        <!-- Corner style (review doc §8.1): an override of the theme's whole corner PROFILE
             (control radii + native window corner), never individual per-control radii. "Theme"
             keeps preset-owned corners. Chip names use the CornerStyle prefix — the catalog-drift
             test predicates key on Theme*Preset / AccentChip* names. -->
        <TextBlock Text="Corners" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <ToggleButton x:Name="CornerStyleThemeChip" Style="{StaticResource PresetToggle}"
                        MinWidth="60" Content="Theme" Tag="theme" Click="CornerStyle_Click"
                        ToolTip="Corners follow the selected theme"
                        AutomationProperties.Name="Corners follow theme" />
          <ToggleButton x:Name="CornerStyleSquareChip" Style="{StaticResource PresetToggle}"
                        MinWidth="60" Content="Square" Tag="square" Click="CornerStyle_Click"
                        ToolTip="Square corners everywhere"
                        AutomationProperties.Name="Square corners" />
          <ToggleButton x:Name="CornerStyleSmallChip" Style="{StaticResource PresetToggle}"
                        MinWidth="60" Content="Small" Tag="small" Click="CornerStyle_Click"
                        ToolTip="Small, sharp corner rounding"
                        AutomationProperties.Name="Small corners" />
          <ToggleButton x:Name="CornerStyleSoftChip" Style="{StaticResource PresetToggle}"
                        MinWidth="60" Content="Soft" Tag="soft" Click="CornerStyle_Click"
                        ToolTip="Moderate, soft corner rounding"
                        AutomationProperties.Name="Soft corners" />
          <ToggleButton x:Name="CornerStyleRoundChip" Style="{StaticResource PresetToggle}"
                        MinWidth="60" Content="Round" Tag="round" Click="CornerStyle_Click"
                        ToolTip="Large, round overlay-style corners"
                        AutomationProperties.Name="Round corners" />
        </StackPanel>

        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,18" />

        <!-- Playback: mode of the NEXT popout, not the app theme (spec settled decision 4). -->
        <TextBlock x:Name="PlaybackSectionHeader" Text="Playback" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
        <TextBlock x:Name="CompactModeHintText"
                   Text="Compact player uses YouTube's embedded player for a cleaner floating window. It applies to new Popout Players only - normal page mode stays the default and the fallback."
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,8" />
        <ToggleButton x:Name="CompactModeToggle" Style="{StaticResource PresetToggle}"
                      MinWidth="150" HorizontalAlignment="Left"
                      Content="Compact player" Click="CompactModeToggle_Click"
                      ToolTip="Use the compact embedded player for new popouts"
                      AutomationProperties.Name="Compact player mode" />

        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,18" />

        <!-- Advanced: fade/opacity/top-bar behavior tuning (overhaul Task 5; future reset-theme
             defaults land here too). The opacity live-preview path (OpacitySlider_ValueChanged ->
             OpacityPreviewChanged) survives the re-section untouched. -->
        <TextBlock x:Name="AdvancedSectionHeader" Text="Advanced" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

        <TextBlock Text="Fade delay" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="FadeDelayShortPreset" Style="{StaticResource PresetToggle}"
                        Content="Short" Tag="1500" Click="FadeDelay_Click"
                        ToolTip="Fade controls after 1.5 seconds"
                        AutomationProperties.Name="Fade delay Short" />
          <ToggleButton x:Name="FadeDelayNormalPreset" Style="{StaticResource PresetToggle}"
                        Content="Normal" Tag="2500" Click="FadeDelay_Click"
                        ToolTip="Fade controls after 2.5 seconds"
                        AutomationProperties.Name="Fade delay Normal" />
          <ToggleButton x:Name="FadeDelayLongPreset" Style="{StaticResource PresetToggle}"
                        Content="Long" Tag="4000" Click="FadeDelay_Click"
                        ToolTip="Fade controls after 4 seconds"
                        AutomationProperties.Name="Fade delay Long" />
        </StackPanel>

        <!-- Whole-window opacity (spec 7.3, Phase 4). Sliders floor at 45% (QA §3); values
             10-45% are honored only when hand-edited into settings.json (the explicit unlock). -->
        <TextBlock Text="Window opacity" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,12,0,6" />
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Active" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center" />
          <Slider x:Name="ActiveOpacitySlider" Grid.Column="1" Minimum="45" Maximum="100"
                  SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                  VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"
                  ToolTip="Popout window opacity while you interact with it (45-100%)"
                  AutomationProperties.Name="Active window opacity" />
          <TextBlock x:Name="ActiveOpacityValueText" Grid.Column="2" FontSize="12" TextAlignment="Right"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="When idle" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center" />
          <Slider x:Name="IdleOpacitySlider" Grid.Column="1" Minimum="45" Maximum="100"
                  SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                  VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"
                  ToolTip="Popout window opacity after the mouse goes idle (45-100%)"
                  AutomationProperties.Name="Idle window opacity" />
          <TextBlock x:Name="IdleOpacityValueText" Grid.Column="2" FontSize="12" TextAlignment="Right"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
        </Grid>

        <!-- Strip auto-hide (spec 7.2, Phase 4): selectable appearance behavior, default off.
             Only engages while the popout's Fade toggle is on (one idleness definition). -->
        <TextBlock Text="Popout top bar" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,12,0,6" />
        <ToggleButton x:Name="StripAutoHideToggle" Style="{StaticResource PresetToggle}"
                      MinWidth="150" HorizontalAlignment="Left"
                      Content="Auto-hide top bar" Click="StripAutoHideToggle_Click"
                      ToolTip="Collapse the popout's top bar while idle so the video fills the window; hover the top edge to bring it back"
                      AutomationProperties.Name="Auto-hide popout top bar" />
      </StackPanel>
      </ScrollViewer>

    </Grid>
  </Border>
</Window>
