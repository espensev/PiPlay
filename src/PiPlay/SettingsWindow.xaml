<Window x:Class="PiPlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PiPlay.Controls"
        Title="PiPlay settings"
        Width="520" Height="680" MinHeight="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        UseLayoutRounding="False"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <Style x:Key="SwatchToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource RadiusSwatch}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PresetToggle" TargetType="ToggleButton">
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Height" Value="{DynamicResource DensityControlHeight}" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource RadiusPanel}" Padding="{DynamicResource DensityPresetChipPadding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderThickness="0">
    <!-- Bounded + scrollable (overhaul Task 5): the title bar stays fixed; the sections scroll.
         Frame model reconciled with the parallel main landing (b35c0dd): a fixed launch Height
         (clamped to the work area in the ctor) instead of SizeToContent, so the dialog cannot
         grow with future sections. -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title bar (drag to move; close button) -->
      <Grid Grid.Row="0" Background="{DynamicResource SurfaceBase}" Height="42"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="Settings" Margin="16,0" VerticalAlignment="Center"
                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        <Button x:Name="CloseButton" Style="{StaticResource CloseIconButton}"
                Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close settings"
                HorizontalAlignment="Right" Margin="0,0,5,0" Click="CloseButton_Click" />
      </Grid>

      <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                    Focusable="False">
      <StackPanel Margin="20">

        <!-- Privacy: distinct Reset app state vs Clear browser data wording/actions
             (REQ-PRIVACY-01/-02; text sourced from PrivacyService so tests pin it). -->
        <TextBlock x:Name="PrivacySectionHeader" Text="Privacy" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />

        <TextBlock x:Name="ResetDescriptionText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,8" />
        <Button x:Name="ResetAppStateButton" Style="{StaticResource DarkButton}"
                HorizontalAlignment="Left" Click="ResetAppStateButton_Click" />

        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,18" />

        <TextBlock x:Name="ClearDescriptionText" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
        <Button x:Name="ClearBrowserDataButton" Style="{StaticResource DarkButton}"
                HorizontalAlignment="Left" Click="ClearBrowserDataButton_Click" />

        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,18" />

        <!-- Appearance (overhaul Task 10): one theme preset + one shared accent replace the separate
             Pin/Fade color swatches. The accent drives Source Pin, Popout Pin, and Popout Fade. -->
        <TextBlock x:Name="AppearanceSectionHeader" Text="Appearance" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

        <TextBlock Text="Theme" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <!-- Accent previews live; Done commits while the title-bar close dismisses. -->
        <TextBlock x:Name="ThemeHintText"
                   Text="Presets, accent, corners, and opacity preview live; Done keeps the changes."
                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,8" />
        <UniformGrid Columns="3" Margin="0,0,0,14">
          <ToggleButton x:Name="ThemeSharpDarkPreset" Style="{StaticResource PresetToggle}"
                        Height="58" Background="#0B0E12" Tag="sharp-dark" Click="ThemePreset_Click"
                        ToolTip="Crisp, compact, and fully opaque"
                        AutomationProperties.Name="Sharp Dark theme — crisp and opaque">
            <StackPanel>
              <TextBlock Text="Sharp Dark" HorizontalAlignment="Center" FontWeight="SemiBold" />
              <Border Width="24" Height="3" Margin="0,5,0,3" HorizontalAlignment="Center"
                      Background="#2BAED0" CornerRadius="{DynamicResource RadiusSwatch}" />
              <TextBlock Text="Crisp · 100%" HorizontalAlignment="Center" FontSize="10" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="ThemeMinimalPreset" Style="{StaticResource PresetToggle}"
                        Height="58" Background="#1C1A16" Tag="minimal" Click="ThemePreset_Click"
                        ToolTip="Quiet, warm, and lightly translucent"
                        AutomationProperties.Name="Minimal theme — quiet and warm">
            <StackPanel>
              <TextBlock Text="Minimal" HorizontalAlignment="Center" FontWeight="SemiBold" />
              <Border Width="24" Height="3" Margin="0,5,0,3" HorizontalAlignment="Center"
                      Background="#3F84C0" CornerRadius="{DynamicResource RadiusSwatch}" />
              <TextBlock Text="Quiet · 94%" HorizontalAlignment="Center" FontSize="10" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="ThemeSoftGlassPreset" Style="{StaticResource PresetToggle}"
                        Height="58" Margin="0" Background="#121A26" Tag="soft-glass" Click="ThemePreset_Click"
                        ToolTip="Airy, cool, and visibly translucent"
                        AutomationProperties.Name="Soft Glass theme — airy and translucent">
            <StackPanel>
              <TextBlock Text="Soft Glass" HorizontalAlignment="Center" FontWeight="SemiBold" />
              <Border Width="24" Height="3" Margin="0,5,0,3" HorizontalAlignment="Center"
                      Background="#9E84F0" CornerRadius="{DynamicResource RadiusSwatch}" />
              <TextBlock Text="Glass · 82%" HorizontalAlignment="Center" FontSize="10" />
            </StackPanel>
          </ToggleButton>
        </UniformGrid>

        <TextBlock Text="Accent color" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <TextBlock x:Name="AccentTargetText" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <controls:AccentColorPicker x:Name="AccentPicker" Margin="0,0,0,12"
                                    ToolTip="Choose the app accent color"
                                    AutomationProperties.Name="Accent color picker" />

        <!-- How far the accent reaches into the chrome. 0 paints only the primary action (no title-bar
             wash, neutral toolbar glyphs); 50 restores full glyphs and the shipped wash; above 50 the
             wash deepens. Previews live. -->
        <TextBlock Text="Accent intensity" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Reach" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center" />
          <Slider x:Name="AccentIntensitySlider" Grid.Column="1" Minimum="0" Maximum="100"
                  SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                  VerticalAlignment="Center" ValueChanged="AccentIntensitySlider_ValueChanged"
                  ToolTip="How far the accent reaches: 0 colors only the main action, 50 restores the shipped toolbar and wash, 100 deepens the title wash"
                  AutomationProperties.Name="Accent intensity" />
          <TextBlock x:Name="AccentIntensityValueText" Grid.Column="2" FontSize="12" TextAlignment="Right"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
        </Grid>

        <!-- Corner style (docs/Theme_Preset_Differences.md): an override of the theme's whole corner PROFILE
             (control radii + native window corner), never individual per-control radii. "Theme"
             keeps preset-owned corners. Chip names use the CornerStyle prefix — the catalog-drift
             test predicates key on Theme*Preset / CornerStyle* names. -->
        <TextBlock Text="Corners" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <ToggleButton x:Name="CornerStyleThemeChip" Style="{StaticResource PresetToggle}"
                        MinWidth="60" Content="Theme" Tag="theme" Click="CornerStyle_Click"
                        ToolTip="Corners follow the selected theme"
                        AutomationProperties.Name="Corners follow theme" />
          <ToggleButton x:Name="CornerStyleSquareChip" Style="{StaticResource PresetToggle}"
                        MinWidth="60" Content="Square" Tag="square" Click="CornerStyle_Click"
                        ToolTip="Square corners everywhere"
                        AutomationProperties.Name="Square corners" />
          <ToggleButton x:Name="CornerStyleSmallChip" Style="{StaticResource PresetToggle}"
                        MinWidth="60" Content="Small" Tag="small" Click="CornerStyle_Click"
                        ToolTip="Small, sharp corner rounding"
                        AutomationProperties.Name="Small corners" />
          <ToggleButton x:Name="CornerStyleRoundChip" Style="{StaticResource PresetToggle}"
                        MinWidth="60" Content="Round" Tag="round" Click="CornerStyle_Click"
                        ToolTip="Large, round overlay-style corners"
                        AutomationProperties.Name="Round corners" />
        </StackPanel>

        <!-- Focused is a Popout PRESENTATION, not the dormant Compact playback mode. It keeps the
             Normal watch page, expands the player without cropping, and adds optional overlay controls.
             The preference affects new popouts only. -->
        <TextBlock Text="Popout presentation" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <ToggleButton x:Name="FocusedOverlayToggle" Style="{StaticResource PresetToggle}"
                      MinWidth="150" HorizontalAlignment="Left"
                      Content="Focused overlay" Click="FocusedOverlayToggle_Click"
                      ToolTip="For new popouts, fill the window with the complete video and show media controls over it"
                      AutomationProperties.Name="Use Focused overlay for new popouts" />
        <TextBlock Text="Fills new Popouts with the complete video without cropping and adds overlay controls."
                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,6,0,12" />

        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,18" />

        <!-- (removed) Playback section: embed Compact player dropped 2026-06 — embed-disabled
             videos break it for near-zero visible gain. New popouts are always Normal. -->

        <!-- Advanced: fade/opacity/top-bar behavior tuning (overhaul Task 5; future reset-theme
             defaults land here too). The opacity live-preview path (OpacitySlider_ValueChanged ->
             OpacityPreviewChanged) survives the re-section untouched. -->
        <TextBlock x:Name="AdvancedSectionHeader" Text="Advanced" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

        <TextBlock Text="Fade delay" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="FadeDelayShortPreset" Style="{StaticResource PresetToggle}"
                        Content="Short" Tag="1500" Click="FadeDelay_Click"
                        ToolTip="Fade controls after 1.5 seconds"
                        AutomationProperties.Name="Fade delay Short" />
          <ToggleButton x:Name="FadeDelayNormalPreset" Style="{StaticResource PresetToggle}"
                        Content="Normal" Tag="2500" Click="FadeDelay_Click"
                        ToolTip="Fade controls after 2.5 seconds"
                        AutomationProperties.Name="Fade delay Normal" />
          <ToggleButton x:Name="FadeDelayLongPreset" Style="{StaticResource PresetToggle}"
                        Content="Long" Tag="4000" Click="FadeDelay_Click"
                        ToolTip="Fade controls after 4 seconds"
                        AutomationProperties.Name="Fade delay Long" />
        </StackPanel>

        <!-- Active opacity also reaches the Source title-bar BACKGROUND (not its controls/browser),
             while the Popout implementation remains whole-window alpha. Sliders floor at 45%; values
             10-45% are honored only when hand-edited into settings.json (the explicit unlock). -->
        <TextBlock Text="Opacity" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,12,0,6" />
        <TextBlock Text="In use affects the Source top bar and whole Popout; idle affects only the whole Popout."
                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,6" />
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="In use" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center" />
          <Slider x:Name="ActiveOpacitySlider" Grid.Column="1" Minimum="45" Maximum="100"
                  SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                  VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"
                  ToolTip="Source top bar and whole Popout opacity while in use (45-100%)"
                  AutomationProperties.Name="Source top bar and active whole popout opacity" />
          <TextBlock x:Name="ActiveOpacityValueText" Grid.Column="2" FontSize="12" TextAlignment="Right"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="When idle" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                     VerticalAlignment="Center" />
          <Slider x:Name="IdleOpacitySlider" Grid.Column="1" Minimum="45" Maximum="100"
                  SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                  VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"
                  ToolTip="Whole popout opacity after the mouse goes idle (45-100%)"
                  AutomationProperties.Name="Idle whole popout opacity" />
          <TextBlock x:Name="IdleOpacityValueText" Grid.Column="2" FontSize="12" TextAlignment="Right"
                     Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
        </Grid>

        <!-- Strip auto-hide (spec 7.2, Phase 4): selectable appearance behavior, default off.
             Only engages while the popout's Fade toggle is on (one idleness definition). -->
        <TextBlock Text="Popout top bar" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,12,0,6" />
        <ToggleButton x:Name="StripAutoHideToggle" Style="{StaticResource PresetToggle}"
                      MinWidth="150" HorizontalAlignment="Left"
                      Content="Auto-hide top bar" Click="StripAutoHideToggle_Click"
                      ToolTip="Collapse the popout's top bar while idle so the video fills the window; hover the top edge to bring it back"
                      AutomationProperties.Name="Auto-hide popout top bar" />
      </StackPanel>
      </ScrollViewer>

      <!-- Fixed footer: a visible affirmative "Done" (apply + close). Lives OUTSIDE SettingsScroll so it stays reachable at any scroll
           position; SurfaceBase + a top hairline pair it with the title bar as a matched action bar. -->
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBase}"
              BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,12">
        <Button x:Name="DoneButton" Style="{StaticResource AccentButton}"
                Content="Done" MinWidth="96" HorizontalAlignment="Right"
                IsDefault="True" IsEnabled="{Binding IsSelectedReadable, ElementName=AccentPicker}"
                Click="DoneButton_Click"
                ToolTip="Apply your changes and close Settings"
                AutomationProperties.Name="Done" />
      </Border>

    </Grid>
  </Border>
</Window>
