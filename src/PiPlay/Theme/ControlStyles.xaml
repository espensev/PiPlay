<!--
  PiPlay control styles - dark, minimal, utility-first (spec section 5).
  Soft rounded rectangles, high-contrast controls, low-glow cyan/purple accents.
  Pin/Fade active state defaults to AccentCyan and can be overridden per control (spec 6.3).

  Theme-controlled values (palette brushes + Radius* corner tokens) are referenced via
  DynamicResource: ThemeResourceApplier REPLACES those dictionary entries on theme change and
  every realized control re-resolves live. Fixed alias brushes (AccentCyan etc.) stay Static.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:PiPlay.Theme">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Base text -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <!-- Generic dark button (rounded, hover surface) -->
  <Style TargetType="Button" x:Key="DarkButton">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="{DynamicResource DensityButtonPadding}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusButton}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary action button (e.g. Pop out video) -->
  <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource DarkButton}">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusButton}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}" />
            </Trigger>
            <!-- Pressed wins over hover (IsPressed implies IsMouseOver): darker fill + a foreground
                 re-picked for that fill so a dim accent's pressed state stays readable (CON-1). -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressed}" />
              <Setter Property="Foreground" Value="{DynamicResource OnAccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Destructive action button (e.g. the Clear browser data confirm): red fill, white text. -->
  <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource DarkButton}">
    <Setter Property="Background" Value="{DynamicResource DangerPin}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusButton}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chrome icon button: 32x32 hit target, transparent, hover surface, rounded.
       Set Content to a glyph (Segoe Fluent / MDL2) or short text. -->
  <Style TargetType="Button" x:Key="IconButton">
    <Setter Property="Width" Value="{DynamicResource DensityIconButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DensityIconButtonSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusIconButton}">
            <!-- Render the glyph through an in-template TextBlock with the icon font set here
                 (template-property precedence), so the app-wide implicit TextBlock style cannot
                 reset it to a non-icon font and drop the glyph to a .notdef box (REQ-UI-02). -->
            <TextBlock Text="{TemplateBinding Content}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Close icon button: red (DangerPin) hover -->
  <Style TargetType="Button" x:Key="CloseIconButton" BasedOn="{StaticResource IconButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusIconButton}">
            <TextBlock Text="{TemplateBinding Content}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerPin}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pin/Fade toggle: active = configurable glyph + subtle active border. -->
  <Style TargetType="ToggleButton" x:Key="PinToggle">
    <Setter Property="Width" Value="{DynamicResource DensityIconButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DensityIconButtonSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTip" Value="Pin (keep on top)" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="theme:ToggleAccent.CheckedBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{DynamicResource RadiusIconButton}" BorderThickness="1">
            <TextBlock Text="{TemplateBinding Content}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark URL / text input. Conventional single-line dark textbox: a rounded Border hosting the
       stretched PART_ContentHost, with the line vertically centred. The text-clipping seen at
       fractional DPI came from the window-level UseLayoutRounding=True (removed on both windows),
       not from this template. (UI-CHK-5) -->
  <Style TargetType="TextBox" x:Key="DarkTextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="{DynamicResource DensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource DensityInputPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusInput}" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark scrollbar (implicit): so an overflowing dropdown/popup never exposes the light
       system scrollbar inside dark chrome (REQ-UI-01). Thin, rounded thumb, no arrow buttons. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{DynamicResource DensityScrollbarThickness}" />
    <Setter Property="MinWidth" Value="{DynamicResource DensityScrollbarThickness}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="{DynamicResource RadiusScrollbarThumb}" Margin="2,0"
                              Background="{DynamicResource SurfaceHover}" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{DynamicResource DensityScrollbarThickness}" />
        <Setter Property="MinHeight" Value="{DynamicResource DensityScrollbarThickness}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border CornerRadius="{DynamicResource RadiusScrollbarThumb}" Margin="0,2"
                                  Background="{DynamicResource SurfaceHover}" />
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Dropdown item: dark, rounded hover. Defined before DarkComboBox so it can be referenced. -->
  <Style TargetType="ComboBoxItem" x:Key="DarkComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="{DynamicResource DensityMenuItemPadding}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource RadiusPopup}" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceRaised}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark combo box for profiles: dark closed control AND dark popup + items, with an
       intentional empty state (no profiles yet) rather than a blank light box (REQ-UI-01). -->
  <Style TargetType="ComboBox" x:Key="DarkComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="{DynamicResource DensityControlHeight}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" Background="{DynamicResource SurfaceRaised}"
                          BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessDefault}"
                          CornerRadius="{DynamicResource RadiusInput}">
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,9,0" Text="&#xE70D;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left" />

            <TextBlock x:Name="Placeholder" Text="Profiles" Margin="10,0,28,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"
                       FontFamily="Segoe UI" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed" />

            <Popup x:Name="Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
              <Border x:Name="DropDownBorder" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0"
                      Background="{DynamicResource SurfaceBase}" BorderBrush="{DynamicResource BorderSubtle}"
                      BorderThickness="{DynamicResource BorderThicknessDefault}" CornerRadius="{DynamicResource RadiusPopup}">
                <Grid>
                  <ScrollViewer x:Name="DropDownScroll" Margin="4"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <StackPanel IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                  <TextBlock x:Name="EmptyText" Text="No saved profiles yet" Margin="12,10"
                             FontFamily="Segoe UI" FontSize="12"
                             Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed" />
                </Grid>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedIndex" Value="-1">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="DropDownScroll" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="EmptyText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- App-wide dark tooltip (implicit: applies to every ToolTip). Placed below the control so
       it does not occlude what it describes, e.g. caption buttons (REQ-UI-01). -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="HorizontalOffset" Value="0" />
    <Setter Property="VerticalOffset" Value="4" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusToolTip}" Padding="{DynamicResource DensityToolTipPadding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
