<!--
  PiPlay color tokens - spec section 5.2.
  Matte black, low-glow cyan/purple accents, utility-first dark UI.
  Each token is exposed as both a Color and a SolidColorBrush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="AppBackgroundColor">#FF0B0D0E</Color>
  <Color x:Key="SurfaceBaseColor">#FF111316</Color>
  <Color x:Key="SurfaceRaisedColor">#FF1C2025</Color>
  <Color x:Key="SurfaceHoverColor">#FF2C323A</Color>
  <Color x:Key="BorderSubtleColor">#FF30363D</Color>
  <Color x:Key="TextPrimaryColor">#FFF3F5F7</Color>
  <Color x:Key="TextSecondaryColor">#FFA7ADB4</Color>
  <Color x:Key="AccentCyanColor">#FF00D4FF</Color>
  <Color x:Key="AccentCyanLightColor">#FF5BE6FF</Color>
  <Color x:Key="AccentPurpleColor">#FF6D3BFF</Color>
  <Color x:Key="AccentVioletColor">#FFA78BFA</Color>
  <Color x:Key="AccentGreenColor">#FF38D996</Color>
  <Color x:Key="AccentAmberColor">#FFFFC857</Color>
  <Color x:Key="DangerPinColor">#FFFF4B55</Color>

  <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}" />
  <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />
  <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="AccentCyan" Color="{StaticResource AccentCyanColor}" />
  <SolidColorBrush x:Key="AccentCyanLight" Color="{StaticResource AccentCyanLightColor}" />
  <SolidColorBrush x:Key="AccentPurple" Color="{StaticResource AccentPurpleColor}" />
  <SolidColorBrush x:Key="AccentViolet" Color="{StaticResource AccentVioletColor}" />
  <SolidColorBrush x:Key="AccentGreen" Color="{StaticResource AccentGreenColor}" />
  <SolidColorBrush x:Key="AccentAmber" Color="{StaticResource AccentAmberColor}" />
  <SolidColorBrush x:Key="DangerPin" Color="{StaticResource DangerPinColor}" />

</ResourceDictionary>
