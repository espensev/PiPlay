<!--
  PiPlay color tokens - spec section 5.2 + UI overhaul Task 9.
  Matte black, low-glow cyan/purple accents, utility-first dark UI.

  Theme-owned tokens (Theme.* / Radius.*) are canonical. The original keys further down are
  compatibility aliases kept during the theme migration; remove an alias only after every
  XAML/code reference migrates to its token.
  The Theme.Accent* defaults below MUST equal AccentPalette.Derive(ThemeCatalog.DefaultAccentColor)
  - XamlInvariantTests pins them. ThemeResourceApplier re-derives the accent family and the
  opacity/fade defaults from the user's settings in App.OnStartup, before any window parses.
  The fixed accent chips (AccentCyan/Violet/Green/Amber...) are NOT theme-derived; they stay
  until Task 10 replaces the legacy Pin/Fade pickers with the single accent path.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Base palette (theme-owned) -->
  <Color x:Key="Theme.AppBackgroundColor">#FF0B0D0E</Color>
  <Color x:Key="Theme.SurfaceBaseColor">#FF111316</Color>
  <Color x:Key="Theme.SurfaceRaisedColor">#FF1C2025</Color>
  <Color x:Key="Theme.SurfaceHoverColor">#FF2C323A</Color>
  <Color x:Key="Theme.BorderSubtleColor">#FF30363D</Color>
  <Color x:Key="Theme.TextPrimaryColor">#FFF3F5F7</Color>
  <Color x:Key="Theme.TextSecondaryColor">#FFA7ADB4</Color>
  <Color x:Key="Theme.DangerColor">#FFFF4B55</Color>
  <Color x:Key="Theme.TextOnDangerColor">#FFFFFFFF</Color>
  <Color x:Key="Theme.MediaBackdropColor">#FF000000</Color>

  <!-- Accent family (theme-owned, derived from the single accent; defaults = sharp-dark #2D6F8F) -->
  <Color x:Key="Theme.AccentColor">#FF2D6F8F</Color>
  <Color x:Key="Theme.AccentHoverColor">#FF46809C</Color>
  <Color x:Key="Theme.AccentPressedColor">#FF265D78</Color>
  <Color x:Key="Theme.AccentDimColor">#FF1E3C4C</Color>
  <Color x:Key="Theme.AccentBorderColor">#FF25536B</Color>
  <Color x:Key="Theme.AccentForegroundColor">#FFFFFFFF</Color>

  <!-- Fixed accent chips (legacy customization palette; not theme-derived) -->
  <Color x:Key="AccentCyanColor">#FF00D4FF</Color>
  <Color x:Key="AccentCyanLightColor">#FF5BE6FF</Color>
  <Color x:Key="AccentCyanForegroundColor">#FF06141A</Color>
  <Color x:Key="AccentPurpleColor">#FF6D3BFF</Color>
  <Color x:Key="AccentVioletColor">#FFA78BFA</Color>
  <Color x:Key="AccentGreenColor">#FF38D996</Color>
  <Color x:Key="AccentAmberColor">#FFFFC857</Color>

  <!-- Brushes for the theme-owned tokens -->
  <SolidColorBrush x:Key="Theme.AppBackground" Color="{StaticResource Theme.AppBackgroundColor}" />
  <SolidColorBrush x:Key="Theme.SurfaceBase" Color="{StaticResource Theme.SurfaceBaseColor}" />
  <SolidColorBrush x:Key="Theme.SurfaceRaised" Color="{StaticResource Theme.SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="Theme.SurfaceHover" Color="{StaticResource Theme.SurfaceHoverColor}" />
  <SolidColorBrush x:Key="Theme.BorderSubtle" Color="{StaticResource Theme.BorderSubtleColor}" />
  <SolidColorBrush x:Key="Theme.TextPrimary" Color="{StaticResource Theme.TextPrimaryColor}" />
  <SolidColorBrush x:Key="Theme.TextSecondary" Color="{StaticResource Theme.TextSecondaryColor}" />
  <SolidColorBrush x:Key="Theme.Danger" Color="{StaticResource Theme.DangerColor}" />
  <SolidColorBrush x:Key="Theme.TextOnDanger" Color="{StaticResource Theme.TextOnDangerColor}" />
  <SolidColorBrush x:Key="Theme.MediaBackdrop" Color="{StaticResource Theme.MediaBackdropColor}" />
  <SolidColorBrush x:Key="Theme.Accent" Color="{StaticResource Theme.AccentColor}" />
  <SolidColorBrush x:Key="Theme.AccentHover" Color="{StaticResource Theme.AccentHoverColor}" />
  <SolidColorBrush x:Key="Theme.AccentPressed" Color="{StaticResource Theme.AccentPressedColor}" />
  <SolidColorBrush x:Key="Theme.AccentDim" Color="{StaticResource Theme.AccentDimColor}" />
  <SolidColorBrush x:Key="Theme.AccentBorder" Color="{StaticResource Theme.AccentBorderColor}" />
  <SolidColorBrush x:Key="Theme.AccentForeground" Color="{StaticResource Theme.AccentForegroundColor}" />

  <!-- Brushes for the fixed accent chips -->
  <SolidColorBrush x:Key="AccentCyan" Color="{StaticResource AccentCyanColor}" />
  <SolidColorBrush x:Key="AccentCyanLight" Color="{StaticResource AccentCyanLightColor}" />
  <SolidColorBrush x:Key="AccentCyanForeground" Color="{StaticResource AccentCyanForegroundColor}" />
  <SolidColorBrush x:Key="AccentPurple" Color="{StaticResource AccentPurpleColor}" />
  <SolidColorBrush x:Key="AccentViolet" Color="{StaticResource AccentVioletColor}" />
  <SolidColorBrush x:Key="AccentGreen" Color="{StaticResource AccentGreenColor}" />
  <SolidColorBrush x:Key="AccentAmber" Color="{StaticResource AccentAmberColor}" />

  <!-- Radius tokens (staged, UI overhaul Task 9 / outline 7.5). Wired this pass: Radius.Button
       (text buttons), Radius.Panel (dropdown), Radius.Settings (swatch/preset toggles).
       Radius.MainWindow/Radius.Popout stay 0 and UNWIRED - WindowChrome CornerRadius is pinned
       by XamlInvariantTests and touches hit testing/DWM/airspace. Radius.Thumbnail has no
       consumer yet. Icon buttons/textbox/combo (8), tooltip/combo item (6), and scrollbar (5)
       keep literals until the radius taxonomy grows names for them. -->
  <CornerRadius x:Key="Radius.MainWindow">0</CornerRadius>
  <CornerRadius x:Key="Radius.Popout">0</CornerRadius>
  <CornerRadius x:Key="Radius.Button">10</CornerRadius>
  <CornerRadius x:Key="Radius.Panel">8</CornerRadius>
  <CornerRadius x:Key="Radius.Thumbnail">8</CornerRadius>
  <CornerRadius x:Key="Radius.Settings">8</CornerRadius>

  <!-- Opacity/fade defaults (theme-owned; re-resolved from settings at startup) -->
  <sys:Double x:Key="Theme.ActiveWindowOpacity">1.0</sys:Double>
  <sys:Double x:Key="Theme.IdleWindowOpacity">1.0</sys:Double>
  <sys:Int32 x:Key="Theme.FadeIdleDelayMs">2500</sys:Int32>

  <!-- Compatibility aliases (Task 9). XAML and code (Prompt.cs, PlayerAppearancePolicy brush
       keys) keep referencing these names during the migration. Alias BRUSHES take their Color
       from the Theme.*Color tokens (single source). Alias COLOR keys must duplicate the hex
       literally - a StaticResource alias ENTRY does not resolve from a BAML-compiled merged
       dictionary - so XamlInvariantTests pins each one equal to its Theme token. The applier
       never replaces aliased keys (only Theme.Accent* and the opacity/fade value tokens, none
       of which are aliased), so value equality is all an alias needs. -->
  <Color x:Key="AppBackgroundColor">#FF0B0D0E</Color>
  <Color x:Key="SurfaceBaseColor">#FF111316</Color>
  <Color x:Key="SurfaceRaisedColor">#FF1C2025</Color>
  <Color x:Key="SurfaceHoverColor">#FF2C323A</Color>
  <Color x:Key="BorderSubtleColor">#FF30363D</Color>
  <Color x:Key="TextPrimaryColor">#FFF3F5F7</Color>
  <Color x:Key="TextSecondaryColor">#FFA7ADB4</Color>
  <Color x:Key="DangerPinColor">#FFFF4B55</Color>
  <SolidColorBrush x:Key="AppBackground" Color="{StaticResource Theme.AppBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource Theme.SurfaceBaseColor}" />
  <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource Theme.SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource Theme.SurfaceHoverColor}" />
  <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource Theme.BorderSubtleColor}" />
  <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource Theme.TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource Theme.TextSecondaryColor}" />
  <SolidColorBrush x:Key="DangerPin" Color="{StaticResource Theme.DangerColor}" />

</ResourceDictionary>
